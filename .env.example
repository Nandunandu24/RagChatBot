# ==========================================
# Agentic AI RAG Chatbot Environment Config
# ==========================================

# Google Gemini API Key (Required for Gemini LLM generation)
# Get key from: https://aistudio.google.com/
GOOGLE_API_KEY=your_google_gemini_api_key_here

# Gemini Model Name (default: gemini-1.5-flash)
GEMINI_MODEL=gemini-1.5-flash

# HuggingFace Embedding Model (Runs locally, no API key needed)
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2

# Vector DB Mode: "auto", "pinecone", or "chroma"
# "auto" will use Pinecone if PINECONE_API_KEY is set, otherwise falls back to local ChromaDB
VECTOR_DB_TYPE=auto

# Pinecone Vector Database Config (Optional)
# Get key from: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=agentic-ai-rag
PINECONE_ENVIRONMENT=us-east-1

# RAG Search Settings
TOP_K_RETRIEVAL=6
